# Скопируй в .env и задай свои значения. Файл .env в git не коммитится.

# --- PostgreSQL ---
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
PROFILE_DB_PASSWORD=change-me
DEBEZIUM_DB_PASSWORD=change-me

# --- Kafka (KRaft) ---
# любой base64 UUID из 22 символов; один раз сгенерировать и не менять
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Valkey ---
VALKEY_PASSWORD=change-me

# --- Keycloak ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
LUMEVA_BFF_CLIENT_SECRET=change-me
PROFILE_SERVICE_CLIENT_SECRET=change-me
# пароль тестовых пользователей user / moderator / admin (только для локальной разработки)
LUMEVA_TEST_USER_PASSWORD=change-me

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me
MONGO_PROFILE_PASSWORD=change-me
